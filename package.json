{
  "name": "smart-clipboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "pnpm run format:web && pnpm run format:rust",
    "format:web": "prettier --write src src-tauri .github *.json *.md docs index.html vite.config.ts tsconfig*.json",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "pnpm run format:web:check && pnpm run format:rust:check",
    "format:web:check": "prettier --check src src-tauri .github *.json *.md docs index.html vite.config.ts tsconfig*.json",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "prepare": "husky",
    "lint": "pnpm run lint:web && pnpm run lint:rust",
    "lint:web": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:web && pnpm run test:rust",
    "typecheck": "vue-tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "test:web:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.6",
    "shadcn-vue": "^2.6.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,md,yml,yaml,css,html}": "prettier --write",
    "*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}
