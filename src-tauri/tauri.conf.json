{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Clipboard",
  "version": "2.8.0",
  "identifier": "com.smartclipboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Smart Clipboard",
        "width": 420,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1OTY2NEM3RjQ1Mjc5NUIKUldSYmVWTDB4MlNXZGE5YUhiWmR4bnM0QUx3dXczY0hhTWNWNWdDV2VCQ3ZhQTN5OHFsWmM4UFkK"
    }
  }
}
